# Web OAuth client ID from Google Cloud Console (APIs & Services > Credentials).
# An Android OAuth client must also exist for package com.luckyangelo.journal with your signing SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Address of journ-al-be.
#   Android emulator:        http://10.0.2.2:3000
#   Phone over USB:          run `adb reverse tcp:3000 tcp:3000`, then http://localhost:3000
#   Deployed (use https):    https://your-api.example.com
EXPO_PUBLIC_API_URL=
