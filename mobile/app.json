{
  "expo": {
    "name": "Journ.al",
    "slug": "journ-al",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#081a1c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.luckyangelo.journal",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withReleaseSigning",
      "expo-status-bar",
      "expo-sqlite",
      "expo-image",
      "expo-sharing",
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#081a1c",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#eca338"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Journ.al lets you attach photos to your pages.",
          "cameraPermission": "Journ.al lets you take a photo for a page."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Journ.al records voice notes for your pages."
        }
      ],
      "expo-asset",
      "@react-native-google-signin/google-signin"
    ],
    "scheme": "journal",
    "backgroundColor": "#081a1c"
  }
}
